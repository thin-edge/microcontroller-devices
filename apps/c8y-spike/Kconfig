# c8y-direct-spikes firmware. Each spike is switched on separately, so its cost
# can be measured on its own (see the change's design.md, D1).

mainmenu "c8y-direct spike firmware"

menu "Spikes"

config SPIKE_TLS_MQTT
	bool "Spike A: MQTTS to Cumulocity (MQTT Service / Core MQTT)"
	help
	  Enable with overlay-spike-a.conf, which also brings in the MQTT,
	  TLS, SNTP and DNS options this spike needs.

if SPIKE_TLS_MQTT

config SPIKE_C8Y_HOST
	string "Cumulocity tenant host"
	help
	  e.g. "example.cumulocity.com". Set it in a git-ignored overlay
	  (c8y-spike.local.conf).

choice SPIKE_ENDPOINT
	prompt "Cumulocity MQTT endpoint"
	default SPIKE_ENDPOINT_MQTT_SERVICE

config SPIKE_ENDPOINT_MQTT_SERVICE
	bool "MQTT Service (9883): SmartREST + free-form telemetry"

config SPIKE_ENDPOINT_CORE
	bool "Core MQTT (8883): SmartREST only"

endchoice

config SPIKE_C8Y_PORT
	int
	default 9883 if SPIKE_ENDPOINT_MQTT_SERVICE
	default 8883

choice SPIKE_AUTH
	prompt "Authentication"
	default SPIKE_AUTH_CERT

config SPIKE_AUTH_CERT
	bool "Mutual TLS (credentials/<device id>.crt and .key)"

config SPIKE_AUTH_BASIC
	bool "Basic auth (Core MQTT only)"

config SPIKE_AUTH_BOOTSTRAP
	bool "Basic auth from the bootstrap user (Spike C, task 5.7; Core MQTT)"
	help
	  Connects as the bootstrap user, polls s/ucr until the device is
	  accepted in the device registration UI, stores the credentials from
	  s/dcr ("70,<tenant>,<user>,<password>") and reconnects as that
	  device user.

config SPIKE_AUTH_ENROLLED
	bool "Mutual TLS with a certificate enrolled on the device (Spike C)"
	help
	  The device generates its key, one-time password and CSR, and
	  enrolls with the Cumulocity CA (overlay-spike-c.conf).

endchoice

config SPIKE_ENROLL_DEVICE_ID
	string "External ID for enrollment (empty: tedge-<MAC>)"
	depends on SPIKE_AUTH_ENROLLED
	default ""

config SPIKE_DEVICE_ID
	string "External ID / MQTT client ID"
	default "tedge-spike-c6"
	help
	  With certificate authentication this must match the certificate's
	  CN, and credentials/<id>.crt and credentials/<id>.key must exist.

config SPIKE_BOOTSTRAP_USER
	string "Bootstrap user (<tenant>/<user>)"
	depends on SPIKE_AUTH_BOOTSTRAP

config SPIKE_BOOTSTRAP_PASSWORD
	string "Bootstrap password"
	depends on SPIKE_AUTH_BOOTSTRAP

config SPIKE_BASIC_USER
	string "Basic auth user (<tenant>/device_<id>)"
	depends on SPIKE_AUTH_BASIC

config SPIKE_BASIC_PASSWORD
	string "Basic auth password"
	depends on SPIKE_AUTH_BASIC

config SPIKE_SNTP_SERVER
	string "SNTP server"
	default "pool.ntp.org"

config SPIKE_TELEMETRY_INTERVAL_S
	int "Telemetry interval (s)"
	default 10

config SPIKE_CONNECT_CYCLES
	int "Measurement: connect/disconnect cycles before normal operation"
	default 0
	help
	  Task 3.5: connect and disconnect this many times, logging the
	  handshake time and mbedTLS heap use of each, before the normal
	  connection starts.

config SPIKE_MQTT_STACK_SIZE
	int "MQTT thread stack size"
	default 10240

endif # SPIKE_TLS_MQTT

config SPIKE_OTA
	bool "Spike B: stream an image into slot1 and test-boot it"
	depends on SPIKE_TLS_MQTT
	help
	  Enable with overlay-spike-b.conf (shell, HTTP client, DFU).

if SPIKE_OTA

config SPIKE_OTA_AUTO_CONFIRM
	bool "Confirm a test-booted image once it reaches Cumulocity"
	default y
	help
	  With this off, the image stays unconfirmed until `spike ota
	  confirm`, and any reset makes MCUboot revert it (tasks 4.2/4.3).

config SPIKE_OTA_MAX_REDIRECTS
	int "HTTP redirects to follow"
	default 3

config SPIKE_OTA_EXTRA_CAS
	bool "Trust GitHub's roots too (task 4.6)"
	help
	  Adds USERTrust ECC (github.com, via Sectigo E46) and ISRG Root X1
	  (release-assets.githubusercontent.com), so a GitHub release asset
	  can be downloaded. github.com's chain needs P-384 and SHA-384; see
	  overlay-github.conf.

config SPIKE_BUILD_TAG
	string "Label printed at boot, to tell test images apart"
	default "A"

endif # SPIKE_OTA

config SPIKE_REMOTE_ACCESS
	bool "Spike F: remote-access tunnel to a LAN host"
	depends on SPIKE_TLS_MQTT
	help
	  Enable with overlay-spike-f.conf.

if SPIKE_REMOTE_ACCESS

choice SPIKE_RA_POLICY
	prompt "Allowed targets"
	default SPIKE_RA_POLICY_LAN

config SPIKE_RA_POLICY_LAN
	bool "The device, or hosts on its IPv4 subnets"

config SPIKE_RA_POLICY_LIST
	bool "Only host:port entries in the allow-list"

config SPIKE_RA_POLICY_LOCAL
	bool "Only the device itself"

endchoice

config SPIKE_RA_ALLOW_LIST
	string "Allow-list (host:port,host:port; used by the allow-list policy)"
	default ""

choice SPIKE_RA_AUTH
	prompt "WebSocket authentication"
	default SPIKE_RA_AUTH_JWT

config SPIKE_RA_AUTH_JWT
	bool "Authorization: Bearer <JWT from s/dat>"

config SPIKE_RA_AUTH_MTLS
	bool "Client certificate only (task 6.3: does it work?)"

endchoice

config SPIKE_RA_BUF_SIZE
	int "Bridge buffer per direction (bytes)"
	default 2048

config SPIKE_RA_IDLE_TIMEOUT_S
	int "Close an idle tunnel after (s, 0 = never)"
	default 900

config SPIKE_RA_MAX_SESSIONS
	int "Concurrent sessions"
	default 1
	range 1 1

endif # SPIKE_REMOTE_ACCESS

endmenu

source "Kconfig.zephyr"
