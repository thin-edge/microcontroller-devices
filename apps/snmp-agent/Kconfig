# SNMP agent application. Shared options come from the lib/common module and SNMP
# options from the lib/snmp module (both auto-sourced as Zephyr modules via
# Kconfig.zephyr below).

mainmenu "SNMP Agent Firmware"

config APP_TEDGE_MEASUREMENT_TYPE
	string "Measurement type published to the cloud"
	depends on TEDGE_TELEMETRY
	default "agent"

config APP_TEDGE_MEASUREMENT_INTERVAL_S
	int "Seconds between measurements"
	depends on TEDGE_TELEMETRY
	default 30

source "Kconfig.zephyr"
