# OPC-UA server application. Shared options come from the lib/common module and
# OPC-UA options from the lib/opcua module; both are auto-sourced as Zephyr
# modules via Kconfig.zephyr below, so this app defines no symbols of its own.

mainmenu "OPC-UA Server Firmware"

config APP_TEDGE_MEASUREMENT_TYPE
	string "Measurement type published to the cloud"
	depends on TEDGE_TELEMETRY
	default "server"

config APP_TEDGE_MEASUREMENT_INTERVAL_S
	int "Seconds between measurements"
	depends on TEDGE_TELEMETRY
	default 30

source "Kconfig.zephyr"
