/* SPDX-License-Identifier: Apache-2.0
 *
 * ESP32-C6 (QIQIAZI board, ESP32-C6-WROOM-1-N4 module) — console + flash size.
 *
 * 1. Console. The board devicetree chooses `uart0`, which is the separate UART
 *    port. This board is connected through its native USB-Serial-JTAG port, so
 *    enable that peripheral and re-choose the console onto it. Without this
 *    there is no console on the port in use.
 *
 *    A USB-Serial-JTAG console re-enumerates on reset, so the earliest boot
 *    output is lost. For early-boot debugging, drop this block and use the
 *    board's UART port with the stock `uart0` console.
 *
 * 2. Flash size and layout. The board devicetree includes
 *    `esp32c6_wroom_n8.dtsi`, which declares an 8 MB part. The module in hand is an **N4**: `esptool flash-id`
 *    reports 4 MB (manufacturer 0x68, device 0x4016) on the ESP32-C6 rev v0.2
 *    with MAC e8:f6:0a:fc:32:0c. Correct the declaration so nothing reasons
 *    from 2 MB of flash that does not exist.
 *
 *    The shared layout (lib/common/dts/layout-esp32c6-4M.dtsi) declares the
 *    4 MB part and replaces the upstream partitions with the MCUboot +
 *    Wi-Fi provisioner layout, which MCUboot and the provisioner are built
 *    with too. A plain build (no --sysbuild) still boots from 0x0 and only
 *    uses its storage partition.
 *
 * No `&wifi` node is enabled here: the ESP32-C6 board devicetree already sets
 * the Wi-Fi node to "okay".
 */

&usb_serial {
	status = "okay";
};

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};
};

#include "../../../lib/common/dts/layout-esp32c6-4M.dtsi"
