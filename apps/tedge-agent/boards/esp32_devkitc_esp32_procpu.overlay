/* SPDX-License-Identifier: Apache-2.0
 *
 * ESP32-WROOM-32: expose a status LED via the `led0` alias for the connectivity
 * indicator (lib/common/status_led.c). GPIO2 is the common on-board LED on
 * DevKitC-style boards; rewire here if your board differs.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led0 = &status_led;
	};

	leds {
		compatible = "gpio-leds";
		status_led: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};
	};
};

/* Flash layout: the MCUboot + Wi-Fi provisioner partitions, shared with
 * MCUboot and the provisioner. A plain build (no --sysbuild) still boots from
 * 0x1000 and only uses its storage partition.
 */
#include "../../../lib/common/dts/layout-esp32-4M.dtsi"
