# Zephyr / west workspace artifacts
build/
build*/
twister-out*/
*.pyc
__pycache__/
build_*.log

# West clones Zephyr and modules as siblings of this repo when it is used as
# the manifest repo; ignore them if they land inside the tree.
/zephyr/
/modules/
/bootloader/
/tools/
/.west/

# Local Wi-Fi credentials and any local-only overlays — never commit secrets.
overlay-wifi-credentials.conf
*.local.conf
credentials.conf

# Soak harness run records (scripts/soak/run.sh)
scripts/soak/runs/

# Per-app / per-module out-of-tree build directories
apps/*/build*/
lib/*/build*/

# Credentials must never be committed. These were tracked once despite the
# files themselves saying "(git-ignored)"; see the removal commit.
credentials/
**/credentials/
*.key
*.csr
*.pem.local
