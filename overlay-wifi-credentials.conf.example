# SPDX-License-Identifier: Apache-2.0
#
# Wi-Fi credentials overlay — EXAMPLE.
#
# Copy this file to `overlay-wifi-credentials.conf` (which is git-ignored) and
# fill in your network details, then build with it applied:
#
#   west build -b esp32_devkitc_wroom/esp32/procpu . \
#       -- -DEXTRA_CONF_FILE=overlay-wifi-credentials.conf
#
# Never commit real credentials to the repository.

CONFIG_APP_WIFI=y
CONFIG_APP_WIFI_SSID="my-network"
CONFIG_APP_WIFI_PSK="my-password"
