# Shared, protocol-agnostic firmware options: device identity, connectivity
# (Wi-Fi), status display, the data-model sampling interval, and the writable
# control points. Protocol frontends (OPC-UA, and later SNMP/Modbus/CAN) build
# on top of these; protocol-specific options live in each lib/<protocol>/Kconfig.

menu "Common firmware options"

config APP_DEVICE_NAME
	string "Device / application name"
	default "tedge-opcua-device"
	help
	  Human-readable device name advertised by protocol frontends and used
	  to derive the default mDNS hostname.

config APP_FIRMWARE_NAME
	string "Firmware name"
	default "zephyr-opcua-server"
	help
	  Identifies the firmware image/application (as opposed to the device).
	  Exposed by frontends (e.g. the OPC-UA node ns=1;s=FirmwareName) and
	  paired with FirmwareVersion so a collector can tell which firmware a
	  device runs. Each apps/<protocol> sets its own default.

config APP_MDNS_HOSTNAME
	string "mDNS hostname (advertised as <hostname>.local)"
	default "tedge-opcua"
	help
	  Hostname advertised over mDNS. The device becomes reachable as
	  "<hostname>.local" on the local network.

config APP_SAMPLE_INTERVAL_MS
	int "Data source sampling interval (ms)"
	default 1000
	range 50 3600000
	help
	  Interval at which the data source is sampled and frontend values are
	  refreshed.

config APP_SETPOINT_MIN
	int "Writable Setpoint minimum"
	default -1000

config APP_SETPOINT_MAX
	int "Writable Setpoint maximum"
	default 1000

config APP_SETPOINT_DEFAULT
	int "Writable Setpoint initial value"
	default 0

config APP_RUNNING_DEFAULT
	bool "Writable 'Running' flag initial value"
	default n

config APP_DISPLAY_STATUS
	bool "Show connectivity status on a TFT display"
	default n
	help
	  On boards with a TFT (e.g. Adafruit Feather ESP32-S2 TFT), show a
	  colour-coded connectivity stage and the device's IPv4 address. Useful
	  to relay status when no serial console is available.

menu "Wi-Fi (station mode) — hardware targets"

config APP_WIFI
	bool "Connect to Wi-Fi in station mode"
	default y if WIFI
	default n
	help
	  Join a Wi-Fi network on boot. On native_sim this is not used; the
	  host network backend provides connectivity instead.

config APP_PING_TARGET
	string "On-device ping target for the data-path diagnostic"
	default "192.168.68.1"
	depends on APP_WIFI
	help
	  IPv4 address the firmware periodically pings to test whether its
	  Wi-Fi data path passes traffic. Result shown on the display as GWPING.

config APP_STATIC_IP
	bool "Use a static IPv4 address instead of DHCP"
	default n
	help
	  Assign a fixed IPv4 address on Wi-Fi association instead of using
	  DHCP. Also set CONFIG_ESP32_WIFI_STA_AUTO_DHCPV4=n on ESP32 boards so
	  DHCP does not override it (see overlay-static-ip.conf.example).

config APP_STATIC_IP_ADDR
	string "Static IPv4 address"
	default "192.168.68.200"
	depends on APP_STATIC_IP

config APP_STATIC_NETMASK
	string "Static IPv4 netmask"
	default "255.255.252.0"
	depends on APP_STATIC_IP

config APP_STATIC_GW
	string "Static IPv4 gateway"
	default "192.168.68.1"
	depends on APP_STATIC_IP

config APP_WIFI_MAC
	string "Override Wi-Fi station MAC (AA:BB:CC:DD:EE:FF; empty = factory MAC)"
	default ""
	depends on APP_WIFI
	help
	  If non-empty, set the Wi-Fi station MAC to this address before
	  connecting (ESP32 only). Use a locally-administered unicast address.

config APP_WIFI_SSID
	string "Wi-Fi SSID"
	default ""
	depends on APP_WIFI
	help
	  Wi-Fi network name. Provide via a git-ignored local overlay
	  (see overlay-wifi-credentials.conf.example) rather than committing it.

config APP_WIFI_PSK
	string "Wi-Fi password (PSK)"
	default ""
	depends on APP_WIFI
	help
	  Wi-Fi pre-shared key. Provide via a git-ignored local overlay; do not
	  commit real credentials to the repository.

endmenu # Wi-Fi

endmenu # Common firmware options
