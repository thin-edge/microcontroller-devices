# Modbus TCP protocol frontend options. Present only when an application composes
# the lib/modbus module (e.g. apps/modbus-server).

menu "Modbus TCP frontend"

config APP_MODBUS_SERVER
	bool "Enable the Modbus TCP server"
	default y
	select MODBUS
	select MODBUS_RAW_ADU
	help
	  Serve the shared device data model over Modbus TCP using Zephyr's
	  in-tree modbus subsystem in raw-ADU server mode plus a TCP listener.
	  Also set CONFIG_MODBUS_ROLE_SERVER=y in the app (it is a Kconfig choice,
	  so it cannot be selected here).

config APP_MODBUS_PORT
	int "Modbus TCP listen port"
	default 502
	range 1 65535
	depends on APP_MODBUS_SERVER

config APP_MODBUS_UNIT_ID
	int "Modbus unit id"
	default 1
	range 1 247
	depends on APP_MODBUS_SERVER

config APP_MODBUS_CLIENT_IDLE_TIMEOUT_S
	int "Drop a client that sends nothing for this long (s; 0 = never)"
	default 60
	range 0 86400
	depends on APP_MODBUS_SERVER
	help
	  The server handles one client at a time, so a connection that has gone
	  half-open (the client vanished during a network outage without a FIN)
	  would otherwise lock every other client out until reboot. A polling
	  collector sends a request every few seconds and is not affected.

endmenu # Modbus TCP frontend
